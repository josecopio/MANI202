// CIUP Events Calendar - data model.
//
// The datasource provider below is rewritten automatically by
// `scripts/set-db-provider.mjs` (run by postinstall / build / db:* scripts)
// from the DATABASE_URL scheme: file:... -> sqlite, postgres(ql)://... -> postgresql.
// Everything in this schema is portable across both (no scalar lists, no Json,
// enums are supported by SQLite since Prisma 6.2).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ORGANISER
  ADMIN
}

// Who may attend. HOUSE_ONLY = only the residents of the house hosting the event.
enum Audience {
  RESIDENTS_ONLY
  PUBLIC
  HOUSE_ONLY
}

// What the event does to the space where it takes place, for everyone not attending.
enum SpaceImpact {
  NONE
  LIMITED
  CLOSED
}

enum Recurrence {
  NONE
  WEEKLY
  MONTHLY
}

enum EventStatus {
  DRAFT
  PENDING
  PUBLISHED
  REJECTED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  role          Role      @default(ORGANISER)
  organisation  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts  Account[]
  sessions  Session[]
  events    Event[]    @relation("EventCreator")
  interests Interest[]
}

// ---- Auth.js (Prisma adapter) tables ----------------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---- Domain -----------------------------------------------------------------

model Category {
  id        String  @id @default(cuid())
  slug      String  @unique
  nameFr    String
  nameEn    String
  color     String // text colour, e.g. #6B2F8A
  bgColor   String // light background colour, e.g. #F3ECF8
  sortOrder Int     @default(0)
  events    Event[]
}

// A residence ("maison") or a shared site (Maison internationale, sports centre, park...).
// Residents subscribe to the houses they live in and use; events belong to a house.
model House {
  id          String  @id @default(cuid())
  slug        String  @unique
  nameFr      String
  nameEn      String
  isResidence Boolean @default(true) // false = shared site nobody lives in (cannot be a "home")
  sortOrder   Int     @default(0)
  venues      Venue[]
  events      Event[]
}

// A space (room, garden...). houseId = null: generic spaces usable in any house ("Other").
model Venue {
  id        String  @id @default(cuid())
  houseId   String?
  nameFr    String
  nameEn    String
  isOther   Boolean @default(false) // when true, Event.customLocation is mandatory
  sortOrder Int     @default(0)
  events    Event[]
  house     House?  @relation(fields: [houseId], references: [id], onDelete: Cascade)

  @@index([houseId])
}

model Event {
  id              String      @id @default(cuid())
  title           String
  description     String // max 400 characters (enforced by zod)
  categoryId      String
  startAt         DateTime
  endAt           DateTime
  venueId         String
  houseId         String? // null = not tied to a house (general event)
  customLocation  String?
  audience        Audience    @default(RESIDENTS_ONLY)
  spaceImpact     SpaceImpact @default(NONE)
  restrictionNote String? // max 200 characters, e.g. "Grand salon réservé de 18h à 22h"
  /// Pass residents need during the event (e.g. access bracelet and where to get it). Null = none.
  accessPass      String?
  /// English versions of the texts above (optional: the French text is shown when empty).
  titleEn           String?
  descriptionEn     String?
  restrictionNoteEn String?
  accessPassEn      String?

  organiserName   String
  contactEmail    String
  registrationUrl String?
  imageUrl        String?
  recurrence      Recurrence  @default(NONE)
  recurrenceEnd   DateTime?
  status          EventStatus @default(DRAFT)
  rejectionReason String?
  reviewedAt      DateTime?
  isSample        Boolean     @default(false)
  createdById     String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  category  Category   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  venue     Venue      @relation(fields: [venueId], references: [id], onDelete: Restrict)
  house     House?     @relation(fields: [houseId], references: [id], onDelete: Restrict)
  createdBy User       @relation("EventCreator", fields: [createdById], references: [id], onDelete: Cascade)
  interests Interest[]

  @@index([status, startAt])
  @@index([createdById])
  @@index([categoryId])
  @@index([venueId])
  @@index([houseId])
}

// "I'm interested": either a signed-in user or an anonymous device cookie.
model Interest {
  id        String   @id @default(cuid())
  eventId   String
  userId    String?
  deviceId  String?
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@unique([eventId, deviceId])
  @@index([userId])
  @@index([deviceId])
}

// Weekly email subscribers (double opt-in).
model Subscriber {
  id                 String    @id @default(cuid())
  email              String    @unique
  locale             String    @default("fr")
  /// Comma-separated slugs: the weekly email only lists these houses (+ general events in the interests). Empty = everything.
  houseSlugs         String    @default("")
  /// Slug of the subscriber\'s own house (its reserved events count as open to them).
  homeSlug           String    @default("")
  categorySlugs      String    @default("")
  token              String    @unique @default(cuid())
  confirmedAt        DateTime?
  /// Last confirmation email sent (cooldown against email-bombing a third party)
  confirmationSentAt DateTime?
  lastSentAt         DateTime?
  createdAt          DateTime  @default(now())
}

/// A browser / device that accepted push notifications (no account needed).
model PushSubscription {
  id         String    @id @default(cuid())
  /// Push service URL: unique per browser profile and secret (it is the device's address).
  endpoint   String    @unique
  p256dh     String
  auth       String
  /// Comma-separated house slugs followed on that device. Empty = every house.
  houseSlugs String    @default("")
  locale     String    @default("fr")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lastSentAt DateTime?
}
