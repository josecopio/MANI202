# ---- Database -------------------------------------------------------------
# Local development (SQLite, file relative to prisma/schema.prisma):
DATABASE_URL="file:./dev.db"
# Production (PostgreSQL) - the provider is switched automatically from the URL:
# DATABASE_URL="postgresql://user:password@host:5432/ciup_events?sslmode=require"
# Behind a transaction pooler (PgBouncer, Neon "pooled" URL, Supabase pooler) add
# &pgbouncer=true, and run migrations with the direct (non-pooled) URL.

# ---- Auth.js --------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Needed outside Vercel (e.g. behind your own reverse proxy)
AUTH_TRUST_HOST="true"
# Public base URL of the site (used in emails, ICS feed, Open Graph tags)
APP_URL="http://localhost:3000"
# Optional: comma-separated emails that become ADMIN the first time they sign in
ADMIN_EMAILS=""

# ---- Email ----------------------------------------------------------------
# Without SMTP_HOST, emails (magic links, approvals, digests) are printed to the
# server console in development. In production SMTP is required.
EMAIL_FROM="CIUP Events <events@example.org>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"

# ---- Weekly digest --------------------------------------------------------
# Secret for GET /api/cron/weekly-digest (Vercel Cron sends it automatically)
CRON_SECRET=""

# ---- Image uploads --------------------------------------------------------
# "disk" (default: local folder, dev / single server with a persistent disk) or
# "database" (stored in the Upload table; for hosts without a persistent disk, e.g. Render free)
UPLOAD_STORAGE="disk"
# Folder used by the disk storage:
UPLOAD_DIR="./uploads"
# On Vercel use Vercel Blob instead (leave empty locally):
BLOB_READ_WRITE_TOKEN=""

# Web push notifications. Generate a key pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contact for the push services (mailto: or https: URL)
VAPID_SUBJECT="mailto:events@example.org"

# ---- Demo mode (test deployments only) --------------------------------------
# "true": no email is ever sent; the sign-in link is shown on screen, so ANYONE can sign
# in with ANY address (including addresses listed in ADMIN_EMAILS). Pages are noindex.
# Meant for user tests on hosts that cannot send email. Never enable it on a real site.
DEMO_MODE="false"
